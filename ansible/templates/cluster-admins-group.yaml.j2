apiVersion: user.openshift.io/v1
kind: Group
metadata:
  name: {{ cluster_admin_group }}
users:
{% for user in cluster_admin_users %}
  - {{ user }}
{% endfor %}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: {{ cluster_admin_group }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: cluster-admin
subjects:
  - apiGroup: rbac.authorization.k8s.io
    kind: Group
    name: {{ cluster_admin_group }}
