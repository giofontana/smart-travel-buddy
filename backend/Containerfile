FROM docker.io/library/python:3.12-slim

WORKDIR /app

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# CPU-only torch: the default PyPI wheel is the CUDA build (several GB of nvidia-* libraries)
RUN pip install torch --index-url https://download.pytorch.org/whl/cpu

# Install dependencies in their own layer so code changes don't reinstall them
COPY pyproject.toml .
RUN mkdir -p src && pip install .

COPY src/ src/
RUN pip install --no-deps --force-reinstall .

COPY alembic/ alembic/
COPY alembic/alembic.ini .

ENV HF_HOME=/tmp/hf_cache

EXPOSE 8000

CMD ["python", "-m", "smart_travel_buddy"]
