# Application Settings
DEBUG=false
PORT=8000

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/travel_agent_db
DATABASE_URL_SYNC=postgresql+psycopg://postgres:postgres@localhost:5432/travel_agent_db

# LLM Configuration
LLM_MODEL=gpt-4o
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-placeholder

# MCP Server URLs
MCP_WEATHER_URL=http://localhost:8001/sse
MCP_CURRENCY_URL=http://localhost:8002/sse
MCP_WIKIPEDIA_URL=http://localhost:8003/sse

# External API Keys
OPENWEATHERMAP_API_KEY=

# MLflow Configuration (optional - leave empty to disable)
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT_NAME=smart-travel-buddy
# For Red Hat OpenShift AI MLflow, set to "kubernetes-namespaced"
MLFLOW_TRACKING_AUTH=
# Optional: manual token auth instead of kubernetes-namespaced (e.g. oc whoami --show-token)
MLFLOW_TRACKING_TOKEN=
# OpenShift project/namespace for MLflow workspace isolation
MLFLOW_WORKSPACE=
